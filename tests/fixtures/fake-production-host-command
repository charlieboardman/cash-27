#!/bin/sh
set -eu

command_name=$(basename "$0")
# Like real rootless Podman, refuse a working directory owned only by root.
if [ "$command_name" = podman ] && ! test -x .; then
  printf 'cannot access the current working directory\n' >&2
  exit 92
fi
printf '%s uid=%s home=%s args=%s\n' \
  "$command_name" "$(id -u)" "${HOME:-}" "$*" >>/tmp/cash-27-root-smoke.log

case "$command_name:$*" in
  "swapon:--show=NAME --noheadings")
    printf '%s\n' /existing-host-swap
    ;;
  "git:"*"rev-parse --short=12 HEAD"*)
    printf '%s\n' 123456789abc
    ;;
  "git:"*"rev-parse HEAD"*)
    printf '%s\n' 123456789abcdef123456789abcdef123456789a
    ;;
  "git:"*"rev-parse --is-inside-work-tree"*)
    printf '%s\n' true
    ;;
  "podman:info --format"*)
    printf '%s\n' v2
    ;;
  "systemctl:start user@"*".service")
    uid=${2#user@}
    uid=${uid%.service}
    mkdir -p "/run/user/$uid"
    chmod 0700 "/run/user/$uid"
    chown "$uid:$uid" "/run/user/$uid"
    ;;
esac

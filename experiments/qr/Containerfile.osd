# Isolated feasibility probe only; not part of the application image.
FROM docker.io/library/python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-osd && rm -rf /var/lib/apt/lists/*
ENV OMP_THREAD_LIMIT=1
COPY experiments/qr/benchmark_osd.py /benchmark_osd.py
ENTRYPOINT ["python", "/benchmark_osd.py"]
